# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demo_user:demo_password@cluster0.example.mongodb.net/imovies?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_imovies_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Default Admin Seed Account (Used on initial seed)
ADMIN_NAME=IMovies Administrator
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@123456

# Payment Gateway Configuration
# Mode: "simulated" or "razorpay"
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Seat Hold Expiration (in minutes)
SEAT_HOLD_DURATION_MINUTES=8
